# ============================================================================
# 微信聊天记录导出工具 wxarchive —— Git 忽略规则
#
# 原则：
#   1. 大体积数据、个人隐私数据、设备绑定密钥一律不入库（可由工具重新生成）
#   2. 若确需提交某项，用 `git add -f <path>` 强制加入（不受本文件限制）
# ============================================================================

# ---------------------------------------------------------------- 个人数据（严禁入库）
# 解密后的聊天数据库（含全部聊天内容）
decrypted/
# 原始加密库快照
snapshot/
# 数据库密钥（设备绑定机密；泄露等于泄露全部聊天记录）
keys/
# 导出产物（含完整聊天记录与个人分析报告）
out/
out3/

# ---------------------------------------------------------------- 依赖与运行时（可重装）
lib/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ---------------------------------------------------------------- 下载缓存与中间产物
download/
update_block_backup/
*.rar
*.7z
*.zip
!tool/wechat-decrypt-main.zip

# ---------------------------------------------------------------- 运行日志与临时文件
logs/*.log
logs/*.err.log
logs/*.json
logs/*.jsonl
scripts/*.log
scripts/**/*.log
_*_messages.txt

# ---------------------------------------------------------------- 反编译/编译产物
scripts/93_findkey_cs/*.exe
scripts/93_findkey_cs/*.pdb
*.obj

# ---------------------------------------------------------------- 本机个人配置
# 项目级配置（含本机数据目录路径）：默认不入库，避免泄露机器路径。
# 若你希望仓库自带默认数据目录，用 `git add -f wxarchive.config.json` 强制加入。
wxarchive.config.json

# ---------------------------------------------------------------- 编辑器与系统
.vs/
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
